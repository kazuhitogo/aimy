fn same(a: [i64], b: [i64]) -> bool {
  if len(a) != len(b) { ret false }
  for i in 0..len(a) {
    if a[i] != b[i] { ret false }
  }
  ret true
} end same

test ref_transfer {
  let mut b0 = [10, 5]
  transfer(mut b0, 0, 1, 3) == Ok(7)
  same(b0, [7, 8])
  let mut b1 = [10, 5]
  transfer(mut b1, 1, 1, 5) == Ok(5)
  same(b1, [10, 5])
  let mut b2 = [10, 5]
  transfer(mut b2, 1, 0, 6) == Err("insufficient funds")
  same(b2, [10, 5])
  let mut b3 = [10, 5]
  transfer(mut b3, 0, 2, 1) == Err("bad account")
  same(b3, [10, 5])
  let mut b4 = [10, 5]
  transfer(mut b4, -1, 0, 1) == Err("bad account")
  same(b4, [10, 5])
  let mut b5 = [10, 5]
  transfer(mut b5, 0, -1, 1) == Err("bad account")
  same(b5, [10, 5])
  let mut b6 = [10, 5]
  transfer(mut b6, 0, 1, 0) == Err("bad amount")
  same(b6, [10, 5])
  let mut b7 = [10, 5]
  transfer(mut b7, 0, 5, -1) == Err("bad account")
  same(b7, [10, 5])
  let mut b8 = [10, 5]
  transfer(mut b8, 1, 1, 6) == Err("insufficient funds")
  same(b8, [10, 5])
} end ref_transfer
