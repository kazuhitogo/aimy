test ref_median {
  median([3, 1, 2]) == 2.0
  median([4, 1, 3, 2]) == 2.5
  median([5]) == 5.0
  median([-3, -4]) == -3.5
  median([9223372036854775807, 9223372036854775807]) == 9223372036854775807.0
  median([-9223372036854775808, -9223372036854775808, 0, 0]) == -4611686018427387904.0
} end ref_median
