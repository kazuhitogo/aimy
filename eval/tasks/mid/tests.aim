test ref_mid {
  mid(1, 2) == 1
  mid(-1, -2) == -1
  mid(-3, 0) == -1
  mid(7, -2) == 2
  mid(9223372036854775807, 9223372036854775807) == 9223372036854775807
  mid(-9223372036854775808, -9223372036854775808) == -9223372036854775808
  mid(9223372036854775807, -9223372036854775808) == 0
  mid(-9223372036854775808, -9223372036854775807) == -9223372036854775807
  mid(9223372036854775807, 9223372036854775806) == 9223372036854775806
} end ref_mid
