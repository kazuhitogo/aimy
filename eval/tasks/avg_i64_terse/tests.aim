test ref_avg_i64 {
  let e: [i64] = []
  avg_i64(e) == Err("empty")
  avg_i64([1, 2]) == Ok(1)
  avg_i64([-1, -2]) == Ok(-1)
  avg_i64([7, -2]) == Ok(2)
  avg_i64([-7, 2]) == Ok(-2)
  avg_i64([9223372036854775807, 9223372036854775807, 9223372036854775807]) == Ok(9223372036854775807)
  avg_i64([-9223372036854775808, -9223372036854775808]) == Ok(-9223372036854775808)
  avg_i64([9223372036854775807, -9223372036854775808]) == Ok(0)
  avg_i64([9223372036854775807, 9223372036854775807, -9223372036854775807]) == Ok(3074457345618258602)
  avg_i64([-9223372036854775808, -9223372036854775808, 1]) == Ok(-6148914691236517205)
} end ref_avg_i64
